# AWS Credentials for HealthScribe
# Get your credentials from: https://console.aws.amazon.com/iam/
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
AWS_REGION=us-east-1

# AWS S3 Bucket for HealthScribe audio files and output
# Create buckets at: https://console.aws.amazon.com/s3/
AWS_S3_BUCKET_NAME=your-healthscribe-bucket-name
AWS_S3_OUTPUT_BUCKET=your-healthscribe-output-bucket

# IAM Role ARN with permissions for HealthScribe
# Create role with S3 and HealthScribe permissions
AWS_HEALTHSCRIBE_DATA_ACCESS_ROLE_ARN=arn:aws:iam::ACCOUNT_ID:role/ROLE_NAME

# HeyDonto API Configuration
# Get your credentials from: https://docs.heydonto.com/
# HeyDonto provides real-time sync with practice management systems (Dentrix, Eaglesoft, OpenDental, etc.)
HEYDONTO_API_KEY=your_heydonto_api_key_here
HEYDONTO_API_URL=https://api.heydonto.com/v1
HEYDONTO_PRACTICE_ID=your_practice_id_here
HEYDONTO_ENABLED=false

# Optional: HeyDonto Webhook Configuration (for real-time updates from PMS)
HEYDONTO_WEBHOOK_SECRET=your_webhook_secret_here
